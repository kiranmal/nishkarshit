# Copy to .env.local and fill in real values. NEVER commit .env.local.

# --- Database (MySQL 8 / MariaDB 10.5+) ------------------------------------
# mysql://<user>:<password>@<host>:3306/<database>
DATABASE_URL=
# ...or instead of DATABASE_URL:  DB_HOST= DB_PORT=3306 DB_NAME= DB_USER= DB_PASSWORD=
# Optional: DB_SSL=true (managed MySQL such as PlanetScale/RDS/Azure) · DB_POOL_SIZE=10
#
# Only needed once, for `npm run db:import-mongo` (copy of your old MongoDB data):
# MONGODB_URI=
# MONGODB_DB=nishkarsh_it

# --- Admin auth ------------------------------------------------------------
# Secret used to sign admin session cookies:  openssl rand -base64 32
ADMIN_SESSION_SECRET=
# Used only by `npm run seed:admin` to create the first Super Admin.
ADMIN_BOOTSTRAP_EMAIL=admin@nishkarshit.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-to-a-long-password

# --- Image storage (REQUIRED on Vercel) ------------------------------------
# https://console.cloudinary.com  → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder inside Cloudinary (default: nishkarsh)
CLOUDINARY_FOLDER=nishkarsh

# --- Site -------------------------------------------------------------------
# Public URL of this site (also editable in Admin → Site Settings)
NEXT_PUBLIC_SITE_URL=https://www.nishkarshit.com
# External Directory application
NEXT_PUBLIC_DIRECTORY_URL=https://directory.nishkarshit.com
# Where /directory/* redirects to (defaults to the Directory URL above)
DIRECTORY_REDIRECT_URL=https://directory.nishkarshit.com
